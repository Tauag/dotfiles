{
  "model": "claude-opus-4-6",
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(docker:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh workflow list:*)",
      "Bash(git describe:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(lsof:*)",
      "Bash(npm ls:*)",
      "Bash(npm run:*)",
      "Bash(rg:*)",
      "Bash(ruff:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(tree:*)",
      "Bash(uv:*)",
      "Bash(wc:*)",
      "Bash(xargs:*)",
      "WebSearch",
      "WebFetch",
      "mcp__claude_ai_Linear__get_issue"
    ],
    "deny": [],
    "ask": []
  },
  "alwaysThinkingEnabled": true,
  "fastMode": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/rm-to-trash.py 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a\\033]0;⏳ Claude waiting for input\\007' > /dev/tty; osascript -e 'display notification \"Claude finished responding\" with title \"Claude Code\" sound name \"Glass\"'"
          },
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/session-crons.sh 2>/dev/null || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a\\033]0;⏳ Claude needs input\\007' > /dev/tty; osascript -e 'display notification \"Claude needs your input\" with title \"Claude Code\" sound name \"Purr\"'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r \".session_id // empty\" | { read -r s; [ -n \"$s\" ] && rm -f ~/.claude/session-crons/\"$s\"; find ~/.claude/session-crons -type f -mtime +7 -delete; } 2>/dev/null || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r \".session_id // empty\" | { read -r s; [ -n \"$s\" ] && rm -f ~/.claude/session-crons/\"$s\"; } 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
